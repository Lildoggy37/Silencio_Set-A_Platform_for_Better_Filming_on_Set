# Local host API settings, matching deploy/.env.example development credentials.
# Never overwrite an existing .env: merge settings and keep real API keys private.
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+asyncpg://silencio:dev_pg_only@127.0.0.1:5432/silencio
REDIS_URL=redis://:dev_redis_only@127.0.0.1:6379/0
CELERY_BROKER_URL=amqp://silencio:dev_mq_only@127.0.0.1:5672/silencio
# Enable explicitly only after local migrations and Redis are ready.
# Set a private random AUTH_SECRET (32-256 bytes); never use a public example key.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
# Reserved for later modules; not consumed by the foundation milestone.
LOCAL_STORAGE_ROOT=
# Script originals default to <repository>/runtime/private-script-files.
# Optional absolute directory override; keep outside static/frontend directories.
# SCRIPT_STORAGE_ROOT=E:/SilencioSetPrivate/script-files
# Scouting photos default to <repository>/runtime/private-location-photos.
# LOCATION_PHOTO_STORAGE_ROOT=E:/SilencioSetPrivate/location-photos
SESSION_SECRET=

# Enable only when the database, dispatcher, worker and local SMTP inbox are configured.
MAIL_ENABLED=false
MAIL_PAYLOAD_KEY=
MAIL_MODE=local
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=silencio@example.com
# Frontend origin only, without path; must also appear in AUTH_ALLOWED_ORIGINS.
INVITATION_PUBLIC_ORIGIN=http://127.0.0.1:5173

# Diane queries and human-confirmed task proposals via Alibaba Cloud Model Studio. Legacy QWEN_API_KEY is accepted. Enable after filling the actual provider endpoint/model ID.
# Keep your existing private .env out of version control.
DIANE_ENABLED=false
# Start the agent dispatcher and worker before enabling background chat.
DIANE_BACKGROUND_ENABLED=false
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
DIANE_TIMEOUT_SECONDS=60
DIANE_MAX_MODEL_CALLS=4
DIANE_MAX_TOOL_CALLS=8
DIANE_MAX_OUTPUT_TOKENS=1500
DIANE_TOKEN_BUDGET=32000
DIANE_CONCURRENCY=2
