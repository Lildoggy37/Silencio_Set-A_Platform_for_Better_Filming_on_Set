# Public local-development credentials ONLY. Not suitable for a remote server.
# Keep passwords URL-safe (letters, digits, underscore, hyphen) for this scaffold.
POSTGRES_PASSWORD=dev_pg_only
REDIS_PASSWORD=dev_redis_only
RABBITMQ_PASSWORD=dev_mq_only
AUTH_ENABLED=false
AUTH_SECRET=
MAIL_ENABLED=false
# Independent private Fernet key; never reuse AUTH_SECRET or QWEN_API_KEY.
MAIL_PAYLOAD_KEY=
INVITATION_PUBLIC_ORIGIN=http://127.0.0.1:5173
